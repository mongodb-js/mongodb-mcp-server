{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containerAppName": { "value": "mongo-mcp-without-auth" },
    "containerAppEnvironmentName": { "value": "" },
    //"containerImage": { "value": "mongodb/mongodb-mcp-server:1.10.0" },   Omitted as now its kept up to date on every release
    "containerCpu": { "value": "1.0" },
    "containerMemory": { "value": "2Gi" },
    "appEnvironmentVars": {
      "value": {
        "MDB_MCP_READ_ONLY": "false",
        "MDB_MCP_HTTP_PORT": "8080",
        "MDB_MCP_HTTP_HOST": "::",
        "MDB_MCP_TRANSPORT": "http",
        "MDB_MCP_LOGGERS": "disk,mcp,stderr",
        "MDB_MCP_LOG_PATH": "/tmp/mongodb-mcp"
        // NOAUTH + an all-interfaces bind ("::") means the server is exposed to
        // the network with no authentication. The server now fails closed and
        // refuses to start unless MDB_MCP_DANGEROUS_HOST_BINDING=true is set.
        // This is a dev/test-only posture (see README). Add the flag below ONLY
        // if you understand and accept that this is an unauthenticated endpoint.
        // "MDB_MCP_DANGEROUS_HOST_BINDING": "true"
      }
    },
    "mdbConnectionString": { "value": "<MONGODB_CONNECTION_STRING>" },
    "authMode": { "value": "NOAUTH" }
  }
}
