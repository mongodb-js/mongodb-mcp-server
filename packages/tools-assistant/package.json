{
  "name": "@mongodb-js/mcp-tools-assistant",
  "version": "3.0.4",
  "type": "module",
  "description": "Assistant tools for the MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/tools-assistant"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-fetch": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mongodb-js/mcp-types": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
