{
  "name": "@mongodb-js/mcp-tools-mongodb",
  "version": "3.0.4",
  "type": "module",
  "description": "MongoDB tools for MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/tools-mongodb"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@mongodb-js/device-id": "^0.4.18",
    "@mongodb-js/mcp-atlas-telemetry": "workspace:*",
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-types": "workspace:*",
    "@mongosh/arg-parser": "^5.6.0",
    "@mongosh/service-provider-node-driver": "^5.0.2",
    "bson": "^7.3.3",
    "hadron-document": "^8.12.0",
    "mongodb": "^7.1.1",
    "mongodb-build-info": "^1.9.16",
    "mongodb-connection-string-url": "^7.0.2",
    "mongodb-schema": "^12.7.0",
    "node-machine-id": "1.1.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mongodb-js/mcp-test-utils": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
