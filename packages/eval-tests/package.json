{
  "name": "@mongodb-js/mcp-eval-tests",
  "version": "3.1.0-pre.1",
  "private": true,
  "type": "module",
  "description": "Braintrust eval harness for the MongoDB MCP server",
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "eval:db-start": "sh scripts/evalDb.sh start",
    "eval:db-stop": "sh scripts/evalDb.sh stop",
    "eval:run": "node_modules/@braintrust/bt/bin/bt eval src/mongodb.eval.ts",
    "eval:debug": "tsx src/mongodb.eval.ts",
    "eval:ci:run": "BRAINTRUST_API_KEY_OVERRIDE=$BRAINTRUST_API_KEY tsx src/scripts/reportCi.ts -- node_modules/@braintrust/bt/bin/bt eval --jsonl src/mongodb.eval.ts",
    "eval:generate-schemas": "tsx src/scripts/generateSchemas.ts",
    "eval:bundle": "tsx src/scripts/bundleEval.ts",
    "eval:serve": "BRAINTRUST_API_KEY_OVERRIDE=$BRAINTRUST_API_KEY node_modules/@braintrust/bt/bin/bt eval --dev src/mongodb.eval.ts",
    "eval:push": "pnpm run eval:bundle && braintrust push dist/mongodb.eval.cjs --if-exists replace"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.54",
    "@ai-sdk/openai": "^4.0.71",
    "@modelcontextprotocol/server": "^2.0.0",
    "@mongodb-js/mcp-cli": "workspace:*",
    "@mongodb-js/mcp-core": "workspace:*",
    "ai": "^7.0.107",
    "braintrust": "^3.36.0",
    "bson": "^7.3.3",
    "mongodb": "^7.6.0",
    "mongodb-mcp-server": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@braintrust/api": "^0.5.0",
    "@braintrust/bt": "^0.22.1",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
