{
  "name": "@mongodb-js/mcp-ui",
  "version": "3.0.4",
  "type": "module",
  "description": "UI components and registry for MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry/registry.d.ts",
      "default": "./dist/registry/registry.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "check:api": "api-extractor run --config api-extractor.json",
    "update:api": "api-extractor run --local --config api-extractor.json",
    "test": "vitest --run",
    "check": "tsc --noEmit --project tsconfig.check.json"
  },
  "devDependencies": {
    "@lg-mcp/embeddable-uis": "^0.1.0",
    "@lg-mcp/hooks": "^0.2.0",
    "@microsoft/api-extractor": "^7.59.2",
    "@mongodb-js/mcp-tools-mongodb": "workspace:*",
    "@mongodb-js/mcp-types": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
