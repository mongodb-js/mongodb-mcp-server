{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "erasableSyntaxOnly": true,
    "composite": true,
    // This package's UI modules are bundled by Vite, and some of its UI
    // dependencies (e.g. @modelcontextprotocol/ext-apps) ship declaration
    // files with extensionless internal imports that nodenext cannot resolve.
    // All source imports in this package keep explicit .js extensions so the
    // emitted library stays nodenext-compatible for consumers.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    "vite.ui.config.ts",
    "src/build/mount.tsx"
  ],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../types" }, { "path": "../tools-mongodb" }]
}
