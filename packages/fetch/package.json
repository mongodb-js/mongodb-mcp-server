{
  "name": "@mongodb-js/mcp-fetch",
  "description": "Shared proxy-aware fetch and httpClient factory for the MongoDB MCP server",
  "version": "3.0.0-prerelease.1",
  "type": "module",
  "license": "Apache-2.0",
  "author": "MongoDB <info@mongodb.com>",
  "repository": {
