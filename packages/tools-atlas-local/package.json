{
  "name": "@mongodb-js/mcp-tools-atlas-local",
  "version": "3.0.0-prerelease.2",
  "type": "module",
  "description": "Atlas Local tools and client for MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/tools-atlas-local"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --build tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@mongodb-js/atlas-local": "^1.3.0",
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-tools-mongodb": "workspace:*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@mongodb-js/mcp-types": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
