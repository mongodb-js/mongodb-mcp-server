{
  "name": "@mongodb-js/mcp-setup",
  "version": "3.0.4",
  "type": "module",
  "description": "Setup wizard and configuration for MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/setup"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@inquirer/select": "^5.2.5",
    "@mongodb-js/mcp-atlas-api-client": "workspace:*",
    "@mongodb-js/mcp-fetch": "workspace:*",
    "@mongodb-js/mcp-atlas-telemetry": "workspace:*",
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-tools-atlas-local": "workspace:*",
    "@mongodb-js/mcp-tools-mongodb": "workspace:*",
    "@mongosh/service-provider-node-driver": "^5.0.2",
    "chalk": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@mongodb-js/mcp-types": "workspace:*",
    "@mongodb-js/mcp-cli": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
