{
  "name": "@mongodb-js/mcp-cli",
  "version": "3.0.4",
  "type": "module",
  "description": "Generic CLI helpers for building MCP servers",
  "license": "Apache-2.0",
  "author": "MongoDB <info@mongodb.com>",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@mongodb-js/mcp-fetch": "workspace:*",
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-http-runners": "workspace:*",
    "@mongodb-js/mcp-logging": "workspace:*",
    "@mongodb-js/mcp-metrics": "workspace:*",
    "@mongodb-js/mcp-atlas-telemetry": "workspace:*",
    "@mongodb-js/mcp-atlas-api-client": "workspace:*",
    "@mongodb-js/mcp-tools-atlas-local": "workspace:*",
    "@mongodb-js/mcp-tools-mongodb": "workspace:*",
    "bson": "^7.3.3",
    "@mongosh/arg-parser": "^5.6.0",
    "mongodb-log-writer": "^3.0.1",
    "ts-levenshtein": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mongodb-js/mcp-types": "workspace:*",
    "@mongodb-js/atlas-local": "^1.3.1",
    "@types/node": "^26.6.2",
    "@types/yargs-parser": "^21.0.3",
    "yargs-parser": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
