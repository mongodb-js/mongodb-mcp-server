{
  "name": "@mongodb-js/mcp-tools-atlas",
  "version": "3.0.0-prerelease.2",
  "type": "module",
  "description": "Atlas tools for MongoDB MCP server",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/tools-atlas"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --build tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@mongodb-js/mcp-atlas-api-client": "workspace:*",
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-tools-mongodb": "workspace:*",
    "mongodb-connection-string-url": "^7.0.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@mongodb-js/mcp-types": "workspace:*",
    "@mongodb-js/mcp-atlas-telemetry": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "@mongodb-js/mcp-test-utils": "workspace:*",
    "@mongodb-js/mcp-ui": "workspace:*",
    "@mongodb-js/mcp-metrics": "workspace:*",
    "@mongodb-js/mcp-cli": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
