{
  "name": "@mongodb-js/mcp-atlas-api-client",
  "version": "3.0.0-prerelease.2",
  "type": "module",
  "description": "Atlas API client for MongoDB MCP server packages",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server.git",
    "directory": "packages/atlas-api-client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --run",
    "check": "tsc --build tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@mongodb-js/mcp-core": "workspace:*",
    "@mongodb-js/mcp-types": "workspace:*",
    "oauth4webapi": "^3.8.5",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
